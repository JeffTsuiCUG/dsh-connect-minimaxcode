node_modules/
dist/
# lib/ is intentionally NOT ignored. Installing from a git source takes the
# repository as-is, so the built output has to be committed; otherwise pnpm
# decides the package "needs to build", runs the prepare step, and refuses:
#   ERR_PNPM_GIT_DEP_PREPARE_NOT_ALLOWED
# Build it with `pnpm build` and commit the result.
*.tsbuildinfo
.DS_Store
*.log
coverage/
.vitest/

# Credentials. The plugin reads MiniMax Code's own login state and stores
# nothing, so any auth file appearing here is a mistake worth failing loudly on.
.env
.env.*
*.auth.json
.qoder-auth.json

# Scratch: probe scripts written while reverse engineering the gateway, and the
# tarball npm pack leaves behind.
*.tgz
