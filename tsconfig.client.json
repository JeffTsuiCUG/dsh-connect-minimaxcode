{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": false,
    "skipLibCheck": true,
    "outDir": "lib",
    "rootDir": "src",
    "types": [],
    "isolatedModules": true
  },
  "include": ["src/client.ts"]
}
